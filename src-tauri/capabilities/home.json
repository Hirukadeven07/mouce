{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "home",
  "description": "The home window: chat, calendar, reminders, shortcuts and every setting.",
  "windows": [
    "home"
  ],
  "permissions": [
    "core:default",
    "allow-get-settings",
    "allow-update-settings",
    "allow-set-api-key",
    "allow-has-api-key",
    "allow-clear-api-key",
    "allow-list-models",
    "allow-test-provider",
    "allow-ollama-status",
    "allow-pull-ollama-model",
    "allow-open-ollama-download",
    "allow-get-autostart",
    "allow-set-autostart",
    "allow-chat-history",
    "allow-chat-send",
    "allow-chat-stop",
    "allow-chat-clear",
    "allow-open-chat",
    "allow-open-home",
    "allow-open-home-chat",
    "allow-close-chat-panel",
    "allow-chat-attachment",
    "allow-chat-discard-attachment",
    "allow-chat-take-draft",
    "allow-circle-start",
    "allow-calendar-between",
    "allow-calendar-reminders",
    "allow-calendar-save",
    "allow-calendar-delete",
    "allow-calendar-set-done",
    "allow-calendar-clear-done",
    "allow-calendar-skip-day",
    "allow-calendar-change-day",
    "allow-calendar-understand"
  ]
}
