{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "chat",
  "description": "The chat panel: asking mouce, circling the screen, and adding a plan from the chat.",
  "windows": [
    "chat"
  ],
  "permissions": [
    "core:default",
    "allow-get-settings",
    "allow-chat-history",
    "allow-chat-send",
    "allow-chat-stop",
    "allow-chat-clear",
    "allow-open-home",
    "allow-open-home-chat",
    "allow-chat-attachment",
    "allow-chat-discard-attachment",
    "allow-chat-take-draft",
    "allow-circle-start",
    "allow-calendar-between",
    "allow-calendar-save",
    "allow-calendar-change-day",
    "allow-calendar-understand"
  ]
}
